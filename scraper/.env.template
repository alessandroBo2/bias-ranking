# Rename this file to .env and enter your tokens

# Apify — for the historical backend and as automatic fallback
APIFY_TOKEN=your_apify_token_here

# ScraperAPI — primary backend (cheaper, handles proxies/CAPTCHAs internally)
# Sign up at https://scraperapi.com, Hobby plan $29/month
SCRAPERAPI_KEY=your_scraperapi_key_here

# Anthropic — for the orchestrator module ("python main.py ask ...")
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SerpApi — for validate_serpapi.py (free plan ~100 searches/month): https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here
