# Rinomina questo file in .env e inserisci i tuoi token

# Apify — per il backend storico e come fallback automatico
APIFY_TOKEN=your_apify_token_here

# ScraperAPI — backend primario (più economico, gestisce proxy/CAPTCHA internamente)
# Registrati su https://scraperapi.com, piano Hobby $29/mese
SCRAPERAPI_KEY=your_scraperapi_key_here

# Anthropic — per il modulo orchestrator ("python main.py ask ...")
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SerpApi — per validate_serpapi.py (free plan ~100 ricerche/mese): https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here
